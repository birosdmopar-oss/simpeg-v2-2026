#!/usr/bin/env bash
# =============================================================================
# SIMPEG v2 — git hook `post-receive` untuk server Dev (F0-18; ISSUE-014 opsi A, CR-021)
#
# Dipasang di bare repo server dev:  <BARE_REPO>/hooks/post-receive  (chmod +x)
# Hanya push ke branch $DEPLOY_BRANCH (default: main) yang dideploy. Urutan:
#   1. checkout commit ke releases/<timestamp>-<sha>
#   2. backend : salin .env bersama (shared/backend.env) -> composer install --no-dev
#   3. frontend: salin .env.local bersama (opsional)     -> npm ci -> npm run build
#      Langkah 1-3 tidak menyentuh database: build yang gagal di sini tidak mengubah DB.
#   4. database: `php spark migrate:status` (hanya membaca) mendaftar migration yang tertunda.
#        RUN_MIGRATIONS=0 (default): migration TIDAK dijalankan. Bila ada yang tertunda, release DITAHAN
#          (sudah dibangun, tidak diaktifkan) dan hook mencetak langkah manual: migrate lewat runbook setelah
#          approval DB Validator, lalu aktifkan dengan rollback.sh <release-id> (README-deploy.md §3a).
#        RUN_MIGRATIONS=1 (hanya dari deploy.env, hanya untuk DEPLOY_BRANCH=main): `php spark migrate --all`,
#          lalu migrate:status dicek ulang, karena spark tetap keluar 0 walau migration gagal.
#   5. symlink `current` -> release baru (atomic), release sebelumnya disimpan di `previous`
#   6. gagal sebelum langkah 4 selesai: release baru dihapus, `current` tidak diubah, DB tidak diubah.
#      gagal saat/setelah migrate: `current` tidak diubah, release DISIMPAN (berisi down() migration untuk
#      rollback manual) dan DB bisa sudah berubah sebagian (DDL MySQL auto-commit) — README-deploy.md §3.
#
# Konfigurasi di <BARE_REPO>/hooks/deploy.env (di-source di bawah):
#   DEPLOY_ROOT     : direktori aplikasi di server, mis. /var/www/simpeg-v2
#   DEPLOY_BRANCH   : branch yang dideploy (default: main — ISSUE-014: server Dev hanya dari main)
#   KEEP_RELEASES   : jumlah release yang disimpan untuk rollback (default: 5)
#   PHP_BIN, COMPOSER_BIN, NPM_BIN : path binary (default: php, composer, npm)
#   RUN_MIGRATIONS  : 0 = migration manual lewat runbook (default); 1 = `php spark migrate --all` otomatis
# DEPLOY_BRANCH dan RUN_MIGRATIONS hanya dibaca dari deploy.env; nilai dari environment proses git diabaikan.
#
# Struktur DEPLOY_ROOT:
#   releases/<id>/{backend,frontend}   snapshot tiap deploy
#   shared/backend.env                 .env backend (berisi secret — dibuat manual sekali, TIDAK dari git)
#   shared/frontend.env.local          .env.local frontend (opsional)
#   shared/writable/                   writable/ backend yang persisten (cache, logs, uploads)
#   current -> releases/<id>           yang disajikan web server (document root: current/backend/public
#                                      untuk API, current/frontend/dist untuk SPA)
#   previous -> releases/<id-lama>     target rollback cepat (deploy/rollback.sh)
#   logs/deploy-<id>.log               log tiap build
# =============================================================================
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BARE_REPO="$(cd "$HOOK_DIR/.." && pwd)"

# Gerbang ISSUE-014: kedua nilai ini hanya boleh datang dari deploy.env.
unset DEPLOY_BRANCH RUN_MIGRATIONS
# shellcheck disable=SC1091
[ -f "$HOOK_DIR/deploy.env" ] && source "$HOOK_DIR/deploy.env"

export BARE_REPO
export DEPLOY_ROOT="${DEPLOY_ROOT:-/var/www/simpeg-v2}"
export DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"
export KEEP_RELEASES="${KEEP_RELEASES:-5}"
export PHP_BIN="${PHP_BIN:-php}"
export COMPOSER_BIN="${COMPOSER_BIN:-composer}"
export NPM_BIN="${NPM_BIN:-npm}"
export RUN_MIGRATIONS="${RUN_MIGRATIONS:-0}"

export RELEASES_DIR="$DEPLOY_ROOT/releases"
export SHARED_DIR="$DEPLOY_ROOT/shared"
export LOG_DIR="$DEPLOY_ROOT/logs"
export CURRENT_LINK="$DEPLOY_ROOT/current"
export PREVIOUS_LINK="$DEPLOY_ROOT/previous"

config_error=""
if [ "$RUN_MIGRATIONS" != "0" ] && [ "$RUN_MIGRATIONS" != "1" ]; then
    config_error="RUN_MIGRATIONS harus 0 atau 1 (deploy.env berisi '$RUN_MIGRATIONS')"
elif [ "$RUN_MIGRATIONS" = "1" ] && [ "$DEPLOY_BRANCH" != "main" ]; then
    config_error="RUN_MIGRATIONS=1 hanya diizinkan untuk DEPLOY_BRANCH=main (deploy.env berisi DEPLOY_BRANCH=$DEPLOY_BRANCH)"
fi
if [ -n "$config_error" ]; then
    cat > /dev/null   # habiskan daftar ref dari git
    echo "==> [deploy] DIBATALKAN: $config_error — tidak ada yang dibangun, database tidak disentuh (ISSUE-014)" >&2
    exit 1
fi

mkdir -p "$RELEASES_DIR" "$SHARED_DIR" "$LOG_DIR"

# -----------------------------------------------------------------------------
# migration_tertunda
# Cetak migration yang belum dijalankan, satu per baris "<namespace>  <version>  <nama>", dari
# `php spark migrate:status` (dijalankan di direktori backend release). Perintah itu tidak menjalankan
# migration; satu-satunya efeknya: pada DB yang belum punya tabel `migrations`, CI4 membuat tabel
# pencatat itu (kosong). Return 1 bila status tidak bisa dibaca (mis. DB tidak terjangkau) — pemanggil
# menghentikan deploy (fail-closed).
# -----------------------------------------------------------------------------
migration_tertunda() {
    local out rc rows
    out="$("$PHP_BIN" spark migrate:status --no-header 2>&1)" && rc=0 || rc=$?
    # Tabel CLI::table: baris data diawali "|", baris pertama = header, kolom terakhir = Batch ("---" = belum).
    rows="$(printf '%s\n' "$out" | sed 's/\x1b\[[0-9;]*m//g' | grep '^|' | tail -n +2)" || true
    if [ "$rc" -ne 0 ] || [ -z "$rows" ]; then
        echo "!!  status migration tidak bisa dibaca (php spark migrate:status, exit $rc):" >&2
        printf '%s\n' "$out" >&2
        return 1
    fi
    printf '%s\n' "$rows" | awk -F'|' '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        trim($(NF-1)) == "---" { printf "      %s  %s  %s\n", trim($2), trim($3), trim($4) }'
}

# -----------------------------------------------------------------------------
# build_release <sha> <release_id> <release_dir> <logfile> <state_file>
# Dijalankan di PROSES BASH TERPISAH dengan `set -euo pipefail` (lihat deploy_ref) supaya langkah
# yang gagal benar-benar menghentikan build. Catatan: bash mengabaikan `set -e` untuk perintah yang
# berada di dalam kondisi if / && / ||, termasuk subshell dan fungsi yang dipanggil dari sana —
# karena itu build tidak boleh dibungkus `if ( ... )` atau `deploy_ref || ...`.
# Hasil untuk deploy_ref ditulis ke <state_file>: `migrate` (migrate mulai dijalankan), `held` (release
# ditahan karena migration tertunda), `active` (current sudah dipindah).
# -----------------------------------------------------------------------------
build_release() {
    local sha="$1" release_id="$2" release_dir="$3" logfile="$4" state_file="$5"
    local pending

    exec > >(tee -a "$logfile") 2>&1

    echo "--- checkout $sha"
    mkdir -p "$release_dir"
    git --git-dir="$BARE_REPO" archive "$sha" | tar -x -C "$release_dir"

    echo "--- backend: composer install --no-dev"
    cd "$release_dir/backend"
    if [ -f "$SHARED_DIR/backend.env" ]; then
        cp "$SHARED_DIR/backend.env" .env
    else
        echo "!!  $SHARED_DIR/backend.env tidak ada — buat dulu dari backend/.env.example" >&2
        return 1
    fi
    # writable/ persisten lintas release
    if [ -d "$SHARED_DIR/writable" ]; then
        rm -rf writable && ln -s "$SHARED_DIR/writable" writable
    fi
    "$COMPOSER_BIN" install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-progress

    echo "--- frontend: npm ci && npm run build"
    cd "$release_dir/frontend"
    if [ -f "$SHARED_DIR/frontend.env.local" ]; then
        cp "$SHARED_DIR/frontend.env.local" .env.local
    fi
    "$NPM_BIN" ci --no-audit --no-fund
    "$NPM_BIN" run build
    rm -rf node_modules   # hasil build ada di dist/, node_modules tidak diperlukan runtime

    # Build selesai. Baru dari sini database disentuh.
    echo "--- database: php spark migrate:status (hanya membaca; migration tidak dijalankan)"
    cd "$release_dir/backend"
    pending="$(migration_tertunda)"
    if [ -z "$pending" ]; then
        echo "    tidak ada migration tertunda"
    elif [ "$RUN_MIGRATIONS" = "1" ]; then
        echo "    migration tertunda:"
        printf '%s\n' "$pending"
        echo "--- database: php spark migrate --all (RUN_MIGRATIONS=1 dari deploy.env; prasyarat runbook DBV harus sudah dipenuhi)"
        echo migrate > "$state_file"
        "$PHP_BIN" spark migrate --all --no-header
        # `spark migrate` keluar 0 walau migration melempar exception → pastikan tidak ada yang tersisa.
        pending="$(migration_tertunda)"
        if [ -n "$pending" ]; then
            echo "!!  migrate --all tidak tuntas; masih tertunda:" >&2
            printf '%s\n' "$pending" >&2
            return 1
        fi
        echo "    migrate selesai, tidak ada migration tertunda"
    else
        echo held > "$state_file"
        cat <<EOF
!!  Ada migration tertunda:
$pending
!!  RUN_MIGRATIONS=0: migration TIDAK dijalankan hook, dan release ini TIDAK diaktifkan (kode baru tidak
    boleh berjalan di atas skema lama). Migration hanya dijalankan MANUAL lewat runbook setelah approval
    DB Validator (ISSUE-014; README-deploy.md §3a):
      1. Pastikan setiap migration di atas sudah disetujui DBV (ada di main lewat PR DBV) dan prasyarat
         runbook-nya terpenuhi (backend/docs/db-review/<dokumen>.md, mis. A-01 Bagian 9.8: backup,
         langkah DBA, pra-cek, jadwal di luar jam kerja).
      2. cd $release_dir/backend
         $PHP_BIN spark migrate --all && $PHP_BIN spark migrate:status   # semua baris harus punya Batch
      3. Verifikasi sesuai runbook, lalu aktifkan release: $DEPLOY_ROOT/rollback.sh $release_id
EOF
        return 0
    fi

    echo "--- switch symlink current -> $release_id"
    cd "$DEPLOY_ROOT"
    if [ -L "$CURRENT_LINK" ]; then
        ln -sfn "$(readlink -f "$CURRENT_LINK")" "$PREVIOUS_LINK"
    fi
    ln -sfn "$release_dir" "$CURRENT_LINK.tmp" && mv -Tf "$CURRENT_LINK.tmp" "$CURRENT_LINK"
    echo active > "$state_file"
    echo "OK  release $release_id aktif"
}

deploy_ref() {
    local newrev="$1"
    local sha short release_id release_dir logfile state_file state rc current_now
    sha="$(git --git-dir="$BARE_REPO" rev-parse "$newrev")"
    short="${sha:0:8}"
    release_id="$(date +%Y%m%d%H%M%S)-$short"
    release_dir="$RELEASES_DIR/$release_id"
    logfile="$LOG_DIR/deploy-$release_id.log"
    state_file="$LOG_DIR/.deploy-$release_id.state"

    echo "==> [deploy] $DEPLOY_BRANCH @ $short -> $release_dir (log: $logfile, RUN_MIGRATIONS=$RUN_MIGRATIONS)"

    # Build di proses bash baru: `set -e` di dalamnya dijamin aktif, dan kegagalan tidak menghentikan hook ini.
    set +e
    bash -c "$(declare -f build_release migration_tertunda); set -euo pipefail; build_release \"\$@\"" \
        _ "$sha" "$release_id" "$release_dir" "$logfile" "$state_file"
    rc=$?
    set -e

    state="$(cat "$state_file" 2>/dev/null || true)"
    rm -f "$state_file"
    current_now="(belum ada)"
    if [ -L "$CURRENT_LINK" ]; then
        current_now="$(readlink -f "$CURRENT_LINK")"
    fi

    # `active` ditulis tepat setelah symlink dipindah: release ini sudah disajikan, jangan dihapus.
    if [ "$state" = "active" ]; then
        echo "==> [deploy] SUKSES: current -> $release_id"
        prune_releases
        return 0
    fi

    if [ "$rc" -eq 0 ] && [ "$state" = "held" ]; then
        echo "==> [deploy] DITAHAN: release $release_id sudah dibangun tetapi TIDAK diaktifkan — ada migration tertunda," >&2
        echo "    jalankan manual lewat runbook setelah approval DBV (langkah di atas / README-deploy.md §3a). current tetap -> $current_now" >&2
        return 1
    fi

    if [ "$state" = "migrate" ]; then
        echo "==> [deploy] GAGAL saat/setelah migrate (exit $rc): current tetap -> $current_now" >&2
        echo "    DATABASE BISA SUDAH BERUBAH SEBAGIAN (DDL MySQL auto-commit). Release $release_id DISIMPAN untuk" >&2
        echo "    migrate:status / migrate:rollback manual dari $release_dir/backend — README-deploy.md §3." >&2
        echo "    lihat log: $logfile" >&2
        return 1
    fi

    echo "==> [deploy] GAGAL (exit $rc): build $release_id dihentikan sebelum migrate — database tidak diubah. current tetap -> $current_now" >&2
    echo "    lihat log: $logfile" >&2
    rm -rf "$release_dir"
    return 1
}

prune_releases() {
    # Simpan KEEP_RELEASES terbaru; jangan hapus yang sedang ditunjuk current/previous.
    local keep="$KEEP_RELEASES" cur prev
    cur="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
    prev="$(readlink -f "$PREVIOUS_LINK" 2>/dev/null || true)"
    ls -1dt "$RELEASES_DIR"/*/ 2>/dev/null | tail -n +"$((keep + 1))" | while read -r old; do
        old="${old%/}"
        if [ "$old" != "$cur" ] && [ "$old" != "$prev" ]; then
            echo "--- prune $old"
            rm -rf "$old"
        fi
    done
}

status=0
while read -r oldrev newrev refname; do
    branch="${refname#refs/heads/}"
    if [ "$branch" != "$DEPLOY_BRANCH" ]; then
        echo "==> [deploy] lewati $refname (hanya branch '$DEPLOY_BRANCH' yang dideploy)"
        continue
    fi
    if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
        echo "==> [deploy] branch dihapus, tidak ada deploy"
        continue
    fi

    set +e
    deploy_ref "$newrev"
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        status=1
    fi
done

exit $status
