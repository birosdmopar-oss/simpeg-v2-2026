#--------------------------------------------------------------------
# SIMPEG v2 Backend — contoh environment (F0-01)
# Salin ke `.env` lalu isi nilai asli. JANGAN commit `.env`.
# Semua key di bawah wajib ada; nilai di sini hanya placeholder.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT: development | testing | production
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE — group default (MySQL 8.x)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.port = 3306
database.default.database = simpeg_v2
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
# strictOn = true dan DBCollat = utf8mb4_unicode_ci diatur di app/Config/Database.php (DBV-010); JANGAN di-override
# lewat database.default.strictOn / database.default.DBCollat.

#--------------------------------------------------------------------
# DATABASE — group tests (dipakai PHPUnit; database terpisah, akan di-migrate:refresh)
#--------------------------------------------------------------------
database.tests.hostname = localhost
database.tests.port = 3306
database.tests.database = simpeg_v2_testing
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = t_

#--------------------------------------------------------------------
# JWT (ADR-003/004) — secret minimal 32 karakter acak, mis: php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------
jwt.secret = CHANGE_ME_GENERATE_RANDOM_64_HEX_CHARACTERS
jwt.issuer = simpeg-v2
jwt.accessTtl = 3600
jwt.refreshTtl = 604800
jwt.cookieDomain =
jwt.cookieSecure = false
jwt.cookieSameSite = Lax

#--------------------------------------------------------------------
# CORS — origin frontend, dipisah koma
#--------------------------------------------------------------------
cors.allowedOrigins = http://localhost:5173

#--------------------------------------------------------------------
# ENCRYPTION (CI4) — generate: php spark key:generate --show
# WAJIB untuk driver email reset password (CR-014): isi antrean email dienkripsi dengan kunci ini (minimal 32 byte).
# Web dan worker antrean memakai .env yang sama. Rotasi: pindahkan kunci lama ke encryption.previousKeys.
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# QUEUE (ADR-013) — driver database, tabel queue_jobs. Queue `email` (tautan reset password, CR-014) dikerjakan worker:
#   php spark queue:work email --stop-when-empty --max-time 55   (cron tiap menit, README-deploy.md §1a)
#--------------------------------------------------------------------
queue.defaultHandler = database
# MariaDB < 10.6 (mis. XAMPP MariaDB 10.4 milik DB Validator) tidak mendukung `FOR UPDATE SKIP LOCKED`: tanpa override
# di bawah, pengambilan job antrean gagal diam-diam (job tidak pernah diproses). Aktifkan HANYA di .env lokal MariaDB
# tersebut; produksi MySQL 8 tetap memakai default true (Config\Queue). CI job MariaDB memakai override yang sama.
# queue.database.skipLocked = false

#--------------------------------------------------------------------
# EMAIL (CR-014, ISSUE-006) — SMTP tautan reset password (auth.resetTokenNotifier = email). Isi di .env server
# saja, JANGAN commit kredensial. 587 + tls (STARTTLS) atau 465 + '' (TLS implisit). Production wajib terenkripsi
# dan email.fromName wajib diisi. SMTPUser & SMTPPass diisi keduanya (AUTH) atau dikosongkan keduanya (relay per IP).
# Uji dari server: php spark email:test <alamat>
#--------------------------------------------------------------------
email.protocol = smtp
email.fromEmail =
email.fromName = SIMPEG
email.SMTPHost =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser =
email.SMTPPass =
email.SMTPTimeout = 10

#--------------------------------------------------------------------
# CACHE (ADR-014) — driver file
#--------------------------------------------------------------------
cache.handler = file

#--------------------------------------------------------------------
# INTEGRASI EKSTERNAL (ADR-015) — driver 'mock' di Fase 0-5; kredensial real diisi di Fase 6
#--------------------------------------------------------------------
integrations.esign.driver = mock
integrations.esign.baseUrl =
integrations.esign.username =
integrations.esign.password =

integrations.siasn.driver = mock
integrations.siasn.baseUrl =
integrations.siasn.clientId =
integrations.siasn.clientSecret =

integrations.push.driver = mock
integrations.push.projectId =
integrations.push.credentialsPath =

#--------------------------------------------------------------------
# LOGGER: 0 = off, 1-9 = threshold (development disarankan 9)
#--------------------------------------------------------------------
logger.threshold = 9

#--------------------------------------------------------------------
# AUTH — Modul A (Fase 1). Nilai lockout/reset masih TBD di dokumen (lihat Config\Auth).
#--------------------------------------------------------------------
auth.lockoutMaxAttempts = 5
auth.lockoutWindowMinutes = 15
auth.lockoutDurationMinutes = 15
auth.passwordMinLength = 8
auth.resetTokenTtl = 1800
auth.forgotMaxPerWindow = 3
auth.forgotWindowMinutes = 60
# HANYA development: kembalikan token reset di response (uji end-to-end tanpa kanal). true DITOLAK di production
# (forgot-password → 500 untuk semua username; reset-password tetap jalan).
auth.exposeResetTokenInResponse = false
# Kanal tautan reset password (ISSUE-006, K3 = email):
#   email = production (CR-014): butuh blok EMAIL di atas, encryption.key, dan worker `php spark queue:work email`
#           yang berjalan (tanpa worker, email tidak pernah terkirim).
#   log   = development, tautan reset (berisi token) ditulis ke writable/logs; mock = test. Keduanya DITOLAK di production.
auth.resetTokenNotifier = log
# URL absolut halaman reset password FRONTEND (tanpa query/fragment); tautan = <nilai ini>#token=<token> (fragment:
# token tidak ikut ke access log web server maupun Referer). Production: WAJIB https (http ditolak, CR-014).
auth.resetLinkBase = http://localhost:5173/reset-password
# Captcha Cloudflare Turnstile: driver 'turnstile' (butuh secret) atau 'mock' (lokal/test, tanpa network).
# 'mock' DITOLAK di production (login, refresh/logout, lupa/reset password → 500 sampai diperbaiki).
auth.captchaDriver = turnstile
auth.turnstileSecretKey =
