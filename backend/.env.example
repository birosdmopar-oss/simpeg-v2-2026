#--------------------------------------------------------------------
# SIMPEG v2 Backend — contoh environment (F0-01)
# Salin ke `.env` lalu isi nilai asli. JANGAN commit `.env`.
# Semua key di bawah wajib ada; nilai di sini hanya placeholder.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT: development | testing | production
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE — group default (MySQL 8.x)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.port = 3306
database.default.database = simpeg_v2
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =

#--------------------------------------------------------------------
# DATABASE — group tests (dipakai PHPUnit; database terpisah, akan di-migrate:refresh)
#--------------------------------------------------------------------
database.tests.hostname = localhost
database.tests.port = 3306
database.tests.database = simpeg_v2_testing
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix = t_

#--------------------------------------------------------------------
# JWT (ADR-003/004) — secret minimal 32 karakter acak, mis: php -r "echo bin2hex(random_bytes(32));"
#--------------------------------------------------------------------
jwt.secret = CHANGE_ME_GENERATE_RANDOM_64_HEX_CHARACTERS
jwt.issuer = simpeg-v2
jwt.accessTtl = 3600
jwt.refreshTtl = 604800
jwt.cookieDomain =
jwt.cookieSecure = false
jwt.cookieSameSite = Lax

#--------------------------------------------------------------------
# CORS — origin frontend, dipisah koma
#--------------------------------------------------------------------
cors.allowedOrigins = http://localhost:5173

#--------------------------------------------------------------------
# ENCRYPTION (CI4) — generate: php spark key:generate --show
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# QUEUE (ADR-013) — driver database, tabel queue_jobs
#--------------------------------------------------------------------
queue.defaultHandler = database

#--------------------------------------------------------------------
# CACHE (ADR-014) — driver file
#--------------------------------------------------------------------
cache.handler = file

#--------------------------------------------------------------------
# INTEGRASI EKSTERNAL (ADR-015) — driver 'mock' di Fase 0-5; kredensial real diisi di Fase 6
#--------------------------------------------------------------------
integrations.esign.driver = mock
integrations.esign.baseUrl =
integrations.esign.username =
integrations.esign.password =

integrations.siasn.driver = mock
integrations.siasn.baseUrl =
integrations.siasn.clientId =
integrations.siasn.clientSecret =

integrations.push.driver = mock
integrations.push.projectId =
integrations.push.credentialsPath =

#--------------------------------------------------------------------
# LOGGER: 0 = off, 1-9 = threshold (development disarankan 9)
#--------------------------------------------------------------------
logger.threshold = 9
