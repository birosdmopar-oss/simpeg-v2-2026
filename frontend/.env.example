# SIMPEG v2 Frontend — salin ke .env.local (di-gitignore). Hanya variabel berprefix VITE_ yang terekspos ke browser.
# Base URL API backend (tanpa trailing slash). Cookie httpOnly hanya terkirim kalau origin ini ada di cors.allowedOrigins backend.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Site key Cloudflare Turnstile (A-03). Kosongkan di lokal -> widget mock (backend auth.captchaDriver=mock).
VITE_TURNSTILE_SITE_KEY=
# Halaman lupa/reset password (A-07, ISSUE-006). false (default) = login menampilkan "Hubungi Admin" dan route
# /lupa-password & /reset-password dialihkan ke login. true HANYA kalau backend punya kanal pengiriman aktif
# (development: auth.resetTokenNotifier=log; production: menunggu driver email).
VITE_PASSWORD_RESET_ENABLED=false
